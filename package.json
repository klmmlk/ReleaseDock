{
  "name": "releasedock",
  "version": "0.1.0",
  "private": true,
  "description": "多软件升级分发系统：Cloudflare Workers + R2 + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p client --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply releasedock --local",
    "db:migrate:remote": "wrangler d1 migrations apply releasedock --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.71",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@types/node": "^22.15.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "~4.35.0"
  }
}
